{
    "layer": "top",
    "position": "top",
    "height": 27, // Altura compacta idêntica à dela
    "spacing": 0,

    "modules-left": [
        "hyprland/workspaces", 
        "hyprland/window"
    ],
    "modules-center": [],
    "modules-right": [
	"custom/microphone",
        "bluetooth",
	"custom/volume", 
        "temperature", 
        "memory",
	"clock",
	"custom/power"
    ],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}",
        "persistent-workspaces": {
            "*": [1, 2, 3, 4,] // Mantém os números fixos igual à imagem
        }
    },

    "hyprland/window": {
        "format": "  {title}"
    },

    "temperature": {
        "thermal-zone": 2,
        "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        "format": " |  {temperatureC}°C |"
    },

    "memory": {
        "format": " {used:0.1f}g |" // Formato de exibição em Gigabytes (ex: 16.8g)
    },

"bluetooth": {
    "format": "{icon}",
    "format-icons": {
      "enabled": "| 󰂯 | ",
      "disabled": "| 󰂲 | "
    },
    "on-click": "~/.config/waybar/scripts/bluetooth-toggle.sh",
    "tooltip-format": "Bluetooth is {status}",
    "interval": 5
  },

    "clock": {
        "format": " {:%A, %B %d   %I:%M%p} ",
        "format-alt": "{:%Y-%m-%d}"
    },

  "custom/power": {
    "format": "| power  ",
    "tooltip": true,
    "tooltip-format": "Power Menu",
    "on-click": "~/.config/waybar/scripts/powermenu.sh"
  }, 

  "custom/microphone": {
    "exec": "~/.config/waybar/scripts/mic.sh",
    "interval": 1,
    "tooltip": true,
    "tooltip-format": "Mic Toggle",
    "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle"
  },

"custom/volume": {
    "exec": "~/.config/waybar/scripts/volume.sh",
    "return-type": "json",
    "interval": 1,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  },

}

