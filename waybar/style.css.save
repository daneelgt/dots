/* Importa o Pywal caso queira usar variáveis, mas abaixo fixei os tons exatos da foto */
@import url("file:///home/ninhux/.cache/wal/colors-waybar.css");

* {
    border: none;
    border-radius: 0;
    font-family: "JetBrainsMono Nerd Font", "monospace";
    font-size: 12px;
}

window#waybar {
    background-color: @background; /* Tom marrom escuro/oliva do fundo da barra dela */
    color: @foreground;            /* Tom sépia/marrom claro do texto apagado */
}

/* Espaçamento e cor das tags/workspaces na esquerda */
#workspaces button {
    padding: 0 8px;
    color: @color8; /* Números inativos bem discretos */
    background-color: transparent;
}

#workspaces button.active {
    color: @color4; /* Número ativo destacado */
}

#workspaces button.urgent {
    color: @color1;
}

/* Nome da janela ativa na esquerda */
#window {
    color: @color6;
}

/* Módulos da direita */
#custom-microphone,
#bluetooth,
#memory,
#temperature,
#custom-volume,
#custom-power,
#clock {
    padding: 0;
    color: @foreground@foreground; /* Usando uma cor de destaque do wallpaper */
    background-color: transparent;
}
