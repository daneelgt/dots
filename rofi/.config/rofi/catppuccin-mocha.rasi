/* ==========================================================================
   Rofi Theme - Minimalist Waybar Match (No Colors / Pure Earth Tones)
   ========================================================================== */

* {
    /* Cores extraídas estritamente da sua Waybar, sem azul/ciano */
    bg-col:      #1a1512;       /* Marrom escuro idêntico ao fundo da sua barra */
    bg-col-light:#241d19;       /* Marrom sutilmente mais claro para a caixa de busca */
    border-col:  #bca285;       /* Borda fina no tom bege/creme dos seus textos */
    selected-col:#2c241f;       /* Destaque do aplicativo selecionado (marrom suave) */
    fg-col:      #bca285;       /* O bege/creme dos textos da barra (~/dots) */
    grey:        #554439;       /* Tom escurecido para textos secundários */

    width: 600;
    font: "JetBrainsMono Nerd Font 11";
}

element-text, element-icon , mode-switcher {
    background-color: inherit;
    text-color:       inherit;
}

window {
    height:           360px;
    border:           1px;      /* Borda ultra fina */
    border-color:     @border-col;
    background-color: @bg-col;
    border-radius:    6px;
}

mainbox {
    background-color: @bg-col;
}

inputbar {
    children:         [prompt,entry];
    background-color: @bg-col;
    border-radius:    5px;
    padding:          2px;
}

prompt {
    background-color: @border-col;
    padding:          6px 12px;
    text-color:       @bg-col;  /* Texto 'drun' invertido para dar leitura no creme */
    border-radius:    4px;
    margin:           10px 0px 0px 10px;
}

entry {
    padding:          6px;
    margin:           10px 10px 0px 10px;
    text-color:       @fg-col;
    background-color: @bg-col-light;
    border-radius:    4px;
}

listview {
    border:           0px;
    padding:          6px 0px 0px;
    margin:           10px 10px 10px 10px;
    columns:          1;
    lines:            5;
    background-color: @bg-col;
}

element {
    padding:          8px;
    background-color: @bg-col;
    text-color:       @fg-col;
    border-radius:    4px;
}

element-icon {
    size: 22px;
}

element selected {
    background-color:  @selected-col; /* Apenas um realce marrom discreto ao selecionar */
    text-color:        @fg-col;       /* Mantém o texto em creme */
}
