{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // ─────────────────────────────────────────────────────────────────────────────
    //  °˖* ૮(  • ᴗ ｡)っ🍸  pewdiepie/archdaemon/dionysh
    //  shhheersh
    //  fastfetch config — nord radioactive glow edition
    // ─────────────────────────────────────────────────────────────────────────────

    "logo": {
        "source": "~/.config/fastfetch/arch.txt",
        "padding": {
            "right": 3
        }
    },
    
    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "key": "OS",
            "format": "{3} {12}"
        },
        {
            "type": "host",
            "key": "Host"
        },
        {
            "type": "kernel",
            "key": "Kernel"
        },
        {
            "type": "uptime",
            "key": "Uptime"
        },
        {
            "type": "packages",
            "key": "Packages"
        },
        {
            "type": "shell",
            "key": "Shell"
        },
        {
            "type": "display",
            "key": "Resolution",
            "compactType": "resolution"
        },
        {
            "type": "wm",
            "key": "WM"
        },
        {
            "type": "theme",
            "key": "Theme"
        },
        {
            "type": "icons",
            "key": "Icons"
        },
        {
            "type": "terminal",
            "key": "Terminal"
        },
        {
            "type": "cpu",
            "key": "CPU",
            "showPeCores": "physical",
            "temp": false
        },
        {
            "type": "gpu",
            "key": "GPU"
        },
        {
            "type": "memory",
            "key": "Memory"
        },
        {
            "type": "disk",
            "key": "Disk",
            "folders": "/"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
